{
  "meta": {
    "name": "HackGov tokens",
    "mode": "light",
    "notes": "Style tokens apontam para core. Surface pode migrar para tons de verde depois."
  },
  "core": {
    "color": {
      "neutral": {
        "50": "#FAFAFA",
        "100": "#F5F5F5",
        "200": "#E5E5E5",
        "300": "#D4D4D4",
        "400": "#A3A3A3",
        "500": "#737373",
        "600": "#525252",
        "700": "#404040",
        "800": "#262626",
        "900": "#171717",
        "950": "#0A0A0A"
      },
      "green": {
        "100": "#EAF4F0",
        "200": "#C7E3D8",
        "300": "#96CAB6",
        "400": "#5CAD8E",
        "500": "#1E8E63",
        "600": "#197854",
        "700": "#145F43",
        "800": "#0F4631",
        "900": "#0A2D1F"
      },
      "blue": {
        "100": "#EAF0F7",
        "200": "#C7D7E9",
        "300": "#96B4D6",
        "400": "#5C8BC0",
        "500": "#1D5FA8",
        "600": "#18508E",
        "700": "#134071",
        "800": "#0E2F53",
        "900": "#091E35"
      },
      "yellow": {
        "100": "#FEF8E7",
        "200": "#FDEDC0",
        "300": "#FADD88",
        "400": "#F8CB47",
        "500": "#F5B700",
        "600": "#CF9A00",
        "700": "#A57B00",
        "800": "#795A00",
        "900": "#4E3A00"
      },
      "red": {
        "100": "#FBEDED",
        "200": "#F5D1CF",
        "300": "#ECA8A5",
        "400": "#E17973",
        "500": "#D6453D",
        "600": "#B53A33",
        "700": "#902E29",
        "800": "#6A221E",
        "900": "#441613"
      }
    }
  },
  "style": {
    "background": {
      "default": { "$ref": "core.color.neutral.100" },
      "foreground": { "$ref": "core.color.neutral.950" }
    },
    "surface": {
      "default": { "$ref": "core.color.neutral.50" },
      "foreground": { "$ref": "core.color.neutral.950" },
      "muted": { "$ref": "core.color.neutral.100" },
      "muted-foreground": { "$ref": "core.color.neutral.700" },
      "secondary": { "$ref": "core.color.neutral.100" },
      "secondary-foreground": { "$ref": "core.color.neutral.950" },
      "accent": { "$ref": "core.color.green.100" },
      "accent-foreground": { "$ref": "core.color.neutral.950" }
    },
    "action": {
      "primary": { "$ref": "core.color.green.500" },
      "primary-foreground": { "$ref": "core.color.neutral.950" },
      "management": { "$ref": "core.color.blue.500" },
      "management-foreground": { "$ref": "core.color.neutral.50" },
      "ticket": { "$ref": "core.color.yellow.500" },
      "ticket-foreground": { "$ref": "core.color.neutral.950" },
      "danger": { "$ref": "core.color.red.500" },
      "danger-foreground": { "$ref": "core.color.neutral.50" }
    },
    "chrome": {
      "border": { "$ref": "core.color.neutral.200" },
      "input": { "$ref": "core.color.neutral.200" },
      "ring": { "$ref": "core.color.green.500" }
    }
  }
}
