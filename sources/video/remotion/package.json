{
  "name": "hackgov-minhavez-video",
  "version": "1.0.0",
  "private": true,
  "description": "Video de apresentacao do HackGov - Minha Vez (Cap 1 FIAP)",
  "type": "module",
  "scripts": {
    "extract": "node scripts/extract-slides.mjs",
    "transcribe": "node scripts/transcribe.mjs",
    "align": "node scripts/align.mjs",
    "prepare-data": "npm run repair-audio && npm run extract && npm run pauses && npm run transcribe && npm run align && npm run music",
    "fase2:slides": "python scripts/rasterize-fase2.py",
    "fase2:pauses": "node scripts/fase-2/detect-pauses.mjs",
    "fase2:transcribe": "node scripts/fase-2/transcribe.mjs",
    "fase2:align": "node scripts/fase-2/align.mjs",
    "fase2:music": "node scripts/fase-2/music-bed.mjs",
    "fase2:timing": "node scripts/fase-2/align.mjs",
    "fase2:prepare": "npm run fase2:slides && npm run fase2:pauses && npm run fase2:align",
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render MinhaVez out/raw.mp4 && node scripts/master-audio.mjs",
    "render:fase2": "remotion render Fase2 out/fase-2.mp4",
    "still": "remotion still MinhaVez out/frame.png",
    "still:fase2": "remotion still Fase2Check out/fase-2-check.png",
    "pauses": "node scripts/detect-pauses.mjs",
    "fetch-model": "bash scripts/fetch-model.sh",
    "sample": "node scripts/make-sample-transcript.mjs",
    "music": "node scripts/music-bed.mjs",
    "master": "node scripts/master-audio.mjs",
    "repair-audio": "node scripts/repair-narration.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.521",
    "@remotion/google-fonts": "4.0.521",
    "@remotion/media-utils": "4.0.521",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.521"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.2.0",
    "@types/react": "19.2.7",
    "cheerio": "1.1.2",
    "ffmpeg-static": "5.3.0",
    "typescript": "5.9.3"
  }
}
